# PTE CIP API — copy to server/.env and fill in.
# Never commit the filled-in file; .gitignore already covers it.

# =============================================================
# Which database this process talks to
# =============================================================
# There is one SQL dialect: PostgreSQL. This stays `postgres`.
DB_DIALECT=postgres

# Where that PostgreSQL runs.
#
#   server  — Supabase, or any Postgres reachable over TCP. Needs DATABASE_URL.
#   pglite  — PostgreSQL compiled to WASM, running inside this process against
#             a local directory. No server, no service, no credentials, no
#             admin rights. This is the offline deployment.
#
# Both run the SAME schema (db/pg/*.sql) and the same application SQL.
PG_DRIVER=server

# --- when PG_DRIVER=server -----------------------------------
# Supabase pooler or any Postgres connection string.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Set to "disable" for a local/self-hosted server with no TLS.
# PGSSL=disable

# --- when PG_DRIVER=pglite -----------------------------------
# Where the database files live. Relative paths resolve against server/, NOT
# the working directory, so a service started from elsewhere finds the same
# data. Defaults to server/.pgdata.
#
# The directory IS the database — back it up. db/pg/*.sql is applied
# automatically the first time, and each file is recorded in
# _pglite_migrations so a restart does not reload it.
#
# `memory://` gives a throwaway instance that is discarded on exit; the test
# suite uses it, deployments should not.
# PGLITE_DATA_DIR=./.pgdata

# =============================================================
# Where profile images live
# =============================================================
# localDisk | supabase
#
# localDisk is the right answer for the PGlite deployment: the images stay on
# the same machine as the database.
STORAGE_DRIVER=localDisk

# --- when STORAGE_DRIVER=localDisk ---------------------------
# Defaults to server/uploads. Back this up alongside the database — the DB only
# stores URLs, not the image bytes.
# UPLOAD_DIR=./uploads
# Must be an ABSOLUTE, browser-reachable base URL: it is stored in
# employees.photo_url and rendered into an <img src> from the client's origin,
# so a relative path would resolve against the client and 404.
PUBLIC_FILE_BASE_URL=http://localhost:4000/files

# --- when STORAGE_DRIVER=supabase ----------------------------
# SUPABASE_URL=https://<project>.supabase.co
# service_role bypasses RLS — server-side only, never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=avatars

# =============================================================
# Auth
# =============================================================
# Signing key for the app's own JWTs. REQUIRED in production: without it the
# code falls back to a known constant, and anyone who can read the source could
# mint a valid admin token.
JWT_SECRET=

# One shared password for every employee. The real access gate is the
# employees-table email check, which the Google path uses too.
SHARED_LOGIN_PASSWORD=

# For POST /api/auth/google. Optional; that route returns 500 without it.
# Not reachable on an offline install — use the shared password there.
GOOGLE_CLIENT_ID=

# =============================================================
# HTTP
# =============================================================
PORT=4000
# CORS origin for the Next.js client. Set this to the real hostname on deploy —
# the localhost default will silently block a deployed frontend.
CLIENT_ORIGIN=http://localhost:3000
